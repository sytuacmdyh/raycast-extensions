{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "timestamp-converter",
  "title": "时间戳转换",
  "description": "时间戳与日期字符串互转，实时显示并复制当前时间",
  "icon": "extension-icon.png",
  "author": "your-raycast-handle",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "private": true,
  "commands": [
    {
      "name": "index",
      "title": "时间戳转换",
      "description": "秒、毫秒时间戳与日期互转，实时查看当前时间",
      "mode": "view",
      "keywords": [
        "timestamp",
        "time",
        "date",
        "时间",
        "日期"
      ]
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@raycast/api": "2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "@raycast/eslint-config": "2.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2"
  }
}
