{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "base64-text-converter",
  "title": "Base64 Text Converter",
  "description": "Convert UTF-8 text to and from Base64 or Base64URL with live results and a Simplified Chinese interface.",
  "icon": "extension-icon.png",
  "author": "sytuacmdyh",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "private": true,
  "commands": [
    {
      "name": "index",
      "title": "Convert Base64 Text",
      "description": "Encode or decode UTF-8 text, switch between Base64 and Base64URL, and copy the result.",
      "mode": "view",
      "keywords": [
        "base64",
        "base64url",
        "encode",
        "decode",
        "编码",
        "解码",
        "Base64 编解码"
      ]
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "store:check": "ray lint",
    "publish": "ray publish"
  },
  "dependencies": {
    "@raycast/api": "2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "@raycast/eslint-config": "2.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2"
  }
}
