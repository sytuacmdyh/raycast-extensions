{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "base64",
  "title": "Base64 编解码",
  "description": "UTF-8 文本与 Base64 互转，支持标准及 URL 安全格式",
  "icon": "extension-icon.png",
  "author": "your-raycast-handle",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "private": true,
  "commands": [
    {
      "name": "index",
      "title": "Base64 编解码",
      "description": "编码或解码 UTF-8 文本，支持 Base64URL 和复制结果",
      "mode": "view",
      "keywords": [
        "base64",
        "base64url",
        "encode",
        "decode",
        "编码",
        "解码"
      ]
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@raycast/api": "2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "@raycast/eslint-config": "2.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2"
  }
}
