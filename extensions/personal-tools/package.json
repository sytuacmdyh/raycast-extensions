{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "personal-tools",
  "title": "Personal Tools",
  "description": "Personal Tools — 自定义跨平台 Raycast 扩展",
  "icon": "extension-icon.png",
  "author": "your-raycast-handle",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "private": true,
  "commands": [
    {
      "name": "index",
      "title": "Extension Home",
      "description": "查看扩展信息并开始开发",
      "mode": "view"
    }
  ],
  "scripts": {
    "dev": "ray develop",
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@raycast/api": "2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.9.3",
    "@raycast/eslint-config": "2.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.6.2"
  }
}
